#!/bin/bash
# 每日自动刷新 pacman 镜像源（由 cronie 的 cron.daily / anacron 调用）
# 安装位置：/etc/cron.daily/update-mirrors（install.sh 会复制 etc/ 下的内容）

set -u
set -o pipefail

# 同一时间只运行一个实例
exec 9>/run/update-mirrors.lock
flock -n 9 || exit 0

# pacman 正在运行时不要替换 mirrorlist
if [[ -e /var/lib/pacman/db.lck ]]; then
  echo "pacman 正在运行，跳过本次镜像源更新。" >&2
  exit 0
fi

# 先写入临时文件，成功后再替换，避免失败时清空 mirrorlist
tmp=$(mktemp /var/tmp/mirrorlist.XXXXXX)
raw=$(mktemp /var/tmp/mirrorlist-raw.XXXXXX)
trap 'rm -f "$tmp" "$raw"' EXIT

# rate-mirrors 默认只测约 1 秒，容易把“握手快、持续下载慢”的镜像排到第一。
# 这里延长测速时间并限制输出数量；mirror.xtom.com.hk 在本机经常在大文件
# 下载中途停住（Operation too slow / HTTP/2 reset），显式排除。
# 本机日常走 Clash TUN 的香港出口；网络环境变化时可改 ENTRY_COUNTRY。
ENTRY_COUNTRY="${MIRROR_ENTRY_COUNTRY:-HK}"
if ! /usr/bin/rate-mirrors \
      --allow-root \
      --protocol https \
      --entry-country "$ENTRY_COUNTRY" \
      --max-per-mirror 5000 \
      --min-per-mirror 2000 \
      --min-bytes-per-mirror 3000000 \
      --max-mirrors-to-output 8 \
      --top-mirrors-number-to-retest 8 \
      arch >"$raw"; then
  echo "rate-mirrors 执行失败，仅使用固定镜像列表。" >&2
  : >"$raw"
fi

# 固定镜像放在最前面：pacman 默认只用第一个能连上的镜像，先保证稳定；
# rate-mirrors 的测速结果作为后续兜底。geo/fastly 同步快，旧版本包 404
# 时会很快跳到 rackspace/NJU 这类保留旧包的镜像。
{
  echo "# Generated by $0 at $(date '+%Y-%m-%d %H:%M:%S %z')"
  echo "# Stable mirrors first; rate-mirrors results below are fallbacks."
  printf 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n'
  printf 'Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch\n'
  printf 'Server = https://taipei.mirror.pkgbuild.com/$repo/os/$arch\n'
  printf 'Server = https://singapore.mirror.pkgbuild.com/$repo/os/$arch\n'
  printf 'Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch\n'
  printf 'Server = https://mirror.osbeck.com/archlinux/$repo/os/$arch\n'
  printf 'Server = https://mirrors.nju.edu.cn/archlinux/$repo/os/$arch\n'
  printf 'Server = https://mirrors.ustc.edu.cn/archlinux/$repo/os/$arch\n'
  grep '^Server = ' "$raw" | grep -v '^Server = https://mirror\.xtom\.com\.hk/' || true
} | awk '!seen[$0]++' >"$tmp"

# rate-mirrors 可能运行数分钟，期间用户可能启动了 pacman；此时不要替换
if [[ -e /var/lib/pacman/db.lck ]]; then
  echo "rate-mirrors 运行期间 pacman 启动了，保留原 mirrorlist。" >&2
  exit 0
fi

if ! grep -q '^Server = ' "$tmp"; then
  echo "未能生成有效的 mirrorlist，保留原文件。" >&2
  exit 1
fi

install -m 644 "$tmp" /etc/pacman.d/mirrorlist
echo "已更新 /etc/pacman.d/mirrorlist（$(grep -c '^Server = ' /etc/pacman.d/mirrorlist) 个镜像）"

# 顺便刷新 Flatpak 远程仓库的 appstream 元数据（只更新“源”，不升级已安装应用）
if command -v flatpak >/dev/null 2>&1; then
  flatpak update --appstream -y ||
    echo "Flatpak appstream 刷新失败，忽略。" >&2
fi
