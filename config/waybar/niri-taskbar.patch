+}
+
+enum Event {
+    Added(String),
+    Removed(String),
+}
+
+/// 托盘索引：任务栏去重用（PID + 名字）
+#[derive(Default, Debug)]
+pub struct TrayIndex {
+    pub pids: std::collections::HashSet<i32>,
+    /// 每个托盘项的（Id, Title）名字集合
+    pub names: Vec<Vec<String>>,
+}
+
+fn normalize(name: &str) -> String {
+    name.trim().to_lowercase()
+}
+
+fn names_match(a: &str, b: &str, allow_substring: bool) -> bool {
+    let a = normalize(a);
+    let b = normalize(b);
+    if a.is_empty() || b.is_empty() {
+        return false;
+    }
+    if a == b {
+        return true;
+    }
+    if !allow_substring {
+        return false;
+    }
+    let (short, long) = if a.len() <= b.len() { (&a, &b) } else { (&b, &a) };
+    short.chars().count() >= 4 && long.contains(short.as_str())
+}
+
+/// 某个托盘项（names）与窗口/分组（app_id + 标题）是否是同一个应用
+fn tray_names_match_window(
+    names: &[String],
+    app_id: Option<&str>,
+    titles: &[String],
+    aliases: &[Vec<String>],
+) -> bool {
+    // 手动别名：别名组里同时出现托盘名字和窗口名字
+    for alias_group in aliases {
+        let alias_names: Vec<String> = alias_group.iter().map(|s| normalize(s)).collect();
+        let tray_hit = names
+            .iter()
+            .any(|tray| alias_names.iter().any(|name| names_match(tray, name, true)));
+        if !tray_hit {
+            continue;
+        }
+        let window_hit = app_id
+            .into_iter()
+            .any(|id| alias_names.iter().any(|name| names_match(id, name, true)))
+            || titles
+                .iter()
+                .any(|title| alias_names.iter().any(|name| names_match(title, name, true)));
+        if window_hit {
+            return true;
+        }
+    }
+
+    // 自动：app_id 精确/包含；标题只做精确匹配
+    for name in names {
+        if let Some(id) = app_id {
+            if names_match(name, id, true) {
+                return true;
+            }
+        }
+        if titles.iter().any(|title| names_match(name, title, false)) {
+            return true;
+        }
+    }
+
+    false
+}
+
+/// 找到某个托盘项对应的窗口（PID 优先，其次名字匹配）
+pub(crate) fn find_window(
+    windows: &[crate::WindowEntry],
+    pid: Option<i32>,
+    names: &[String],
+    aliases: &[Vec<String>],
+) -> Option<u64> {
+    if let Some(pid) = pid {
+        if let Some(window) = windows.iter().find(|window| window.pid == Some(pid)) {
+            return Some(window.id);
+        }
+    }
+
+    windows.iter().find_map(|window| {
+        let titles: Vec<String> = window.title.clone().into_iter().collect();
+        if tray_names_match_window(names, window.app_id.as_deref(), &titles, aliases) {
+            Some(window.id)
+        } else {
+            None
+        }
+    })
+}
+
+/// 窗口分组（app_id + 窗口标题）是否因为托盘图标而隐藏
+pub(crate) fn group_has_tray(
+    index: &TrayIndex,
+    app_id: Option<&str>,
+    titles: &[String],
+    aliases: &[Vec<String>],
+) -> bool {
+    index
+        .names
+        .iter()
+        .any(|names| tray_names_match_window(names, app_id, titles, aliases))
+}
