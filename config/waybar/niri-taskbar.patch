+/// 用 GTK 当前图标主题查找（symbolic 等主题内图标）
+fn load_from_gtk_theme(name: &str, size: i32) -> Option<Pixbuf> {
+    thread_local! {
+        static THEME: gtk::IconTheme = gtk::IconTheme::default().unwrap_or_default();
+    }
+
+    THEME.with(|theme| {
+        let info = theme.lookup_icon_for_scale(name, size, 1, gtk::IconLookupFlags::empty())?;
+        let filename = info.filename()?;
+        Pixbuf::from_file_at_scale(&filename, size, size, true).ok()
+    })
+}
