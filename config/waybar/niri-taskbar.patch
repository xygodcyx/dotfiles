+/// 从 IconThemePath 里找图标（应用自带的图标目录）
+fn load_from_theme_path(theme_path: &str, icon_name: &str, size: i32) -> Option<Pixbuf> {
+    let extensions = ["png", "svg"];
+    let sizes = [size, 16, 22, 24, 32, 48, 64, 128];
+    let categories = ["apps", "status", "panel", "devices", "categories", ""];
+
+    for category in categories {
+        for s in sizes {
+            for ext in extensions {
+                let dir = if category.is_empty() {
+                    format!("{theme_path}/{s}x{s}")
+                } else {
+                    format!("{theme_path}/{s}x{s}/{category}")
+                };
+                let path = format!("{dir}/{icon_name}.{ext}");
+                if let Ok(pb) = Pixbuf::from_file_at_scale(&path, size, size, true) {
+                    return Some(pb);
+                }
+            }
+        }
+    }
+
+    // 有些应用直接把图标放在根目录
+    for ext in extensions {
+        let path = format!("{theme_path}/{icon_name}.{ext}");
+        if let Ok(pb) = Pixbuf::from_file_at_scale(&path, size, size, true) {
+            return Some(pb);
+        }
+    }
+
+    None
+}
