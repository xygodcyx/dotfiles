+#[cfg(test)]
+mod tests {
+    use super::visible_range;
+
+    #[test]
+    fn shows_everything_when_under_the_limit() {
+        assert_eq!(visible_range(0, 3, 5), 0..3);
+        assert_eq!(visible_range(2, 3, 5), 0..3);
+    }
+
+    #[test]
+    fn centres_the_focused_group() {
+        assert_eq!(visible_range(0, 10, 5), 0..5);
+        assert_eq!(visible_range(1, 10, 5), 0..5);
+        assert_eq!(visible_range(2, 10, 5), 0..5);
+        assert_eq!(visible_range(5, 10, 5), 3..8);
+        assert_eq!(visible_range(7, 10, 5), 5..10);
+        assert_eq!(visible_range(9, 10, 5), 5..10);
+    }
+
+    #[test]
+    fn handles_small_limits() {
+        assert_eq!(visible_range(0, 10, 2), 0..2);
+        assert_eq!(visible_range(4, 10, 2), 4..6);
+        assert_eq!(visible_range(9, 10, 2), 8..10);
+        assert_eq!(visible_range(4, 10, 1), 4..5);
+    }
+
+    #[test]
+    fn zero_means_unlimited() {
+        assert_eq!(visible_range(9, 10, 0), 0..10);
+    }
+}
