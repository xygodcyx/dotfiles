+// ── org.kde.StatusNotifierWatcher ───────────────────────────────────
+struct Watcher {
+    items: Mutex<Vec<String>>,
+    host_registered: AtomicBool,
+    tx: async_channel::Sender<Event>,
+}
+
+#[interface(name = "org.kde.StatusNotifierWatcher")]
+impl Watcher {
+    async fn register_status_notifier_item(
+        &self,
+        service: String,
+        #[zbus(header)] header: zbus::message::Header<'_>,
+        #[zbus(signal_emitter)] emitter: SignalEmitter<'_>,
+    ) {
+        // 只给路径时，服务名就是调用者的唯一总线名（SNI 规范）
+        let item = if service.starts_with('/') {
+            match header.sender() {
+                Some(sender) => format!("{sender}{service}"),
+                None => return,
+            }
+        } else {
+            normalize_item(&service)
+        };
+
+        {
+            let mut items = self.items.lock().expect("watcher items lock");
+            if items.contains(&item) {
+                return;
+            }
+            items.push(item.clone());
+        }
+
+        tracing::debug!(item, "tray: item registered");
+        let _ = self.tx.send(Event::Added(item.clone())).await;
+        let _ = Self::status_notifier_item_registered(&emitter, &item).await;
+    }
+
+    async fn register_status_notifier_host(
+        &self,
+        _service: String,
+        #[zbus(signal_emitter)] emitter: SignalEmitter<'_>,
+    ) {
+        self.host_registered.store(true, Ordering::SeqCst);
+        let _ = Self::status_notifier_host_registered(&emitter).await;
+    }
+
+    #[zbus(property)]
+    fn registered_status_notifier_items(&self) -> Vec<String> {
+        self.items.lock().expect("watcher items lock").clone()
+    }
+
+    #[zbus(property)]
+    fn is_status_notifier_host_registered(&self) -> bool {
+        self.host_registered.load(Ordering::SeqCst)
+    }
+
+    #[zbus(property)]
+    fn protocol_version(&self) -> i32 {
+        0
+    }
+
+    #[zbus(signal, name = "StatusNotifierItemRegistered")]
+    async fn status_notifier_item_registered(
+        emitter: &SignalEmitter<'_>,
+        service: &str,
+    ) -> zbus::Result<()>;
+
+    #[zbus(signal, name = "StatusNotifierItemUnregistered")]
+    async fn status_notifier_item_unregistered(
+        emitter: &SignalEmitter<'_>,
+        service: &str,
+    ) -> zbus::Result<()>;
+
+    #[zbus(signal, name = "StatusNotifierHostRegistered")]
+    async fn status_notifier_host_registered(emitter: &SignalEmitter<'_>) -> zbus::Result<()>;
+}
