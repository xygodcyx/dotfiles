+/// `service` 或 `service/path` → `service/path`
+fn normalize_item(service: &str) -> String {
+    if service.contains('/') {
+        service.to_string()
+    } else {
+        format!("{service}{DEFAULT_ITEM_PATH}")
+    }
+}
+
+fn split_item(item: &str) -> (String, String) {
+    match item.split_once('/') {
+        Some((service, path)) => (service.to_string(), format!("/{path}")),
+        None => (item.to_string(), DEFAULT_ITEM_PATH.to_string()),
+    }
+}
