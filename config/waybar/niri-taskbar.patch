+/// 用户自定义图标：$XDG_CONFIG_HOME/waybar/icons/<app_id>.{png,svg}
+fn lookup_override(id: &str) -> Option<PathBuf> {
+    let config_home = std::env::var_os("XDG_CONFIG_HOME")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".config")))?;
+
+    for ext in ["png", "svg"] {
+        let path = config_home.join("waybar").join("icons").join(format!("{id}.{ext}"));
+        if path.exists() {
+            return Some(path);
+        }
+    }
+
+    None
+}
+
