+/// 计算要显示的分组区间：以聚焦分组为中心，最多 `max` 个；
+/// 聚焦分组靠近两端时向另一端贴齐。
+fn visible_range(focus_idx: usize, len: usize, max: usize) -> std::ops::Range<usize> {
+    if max == 0 || len <= max {
+        return 0..len;
+    }
+
+    let half = (max - 1) / 2;
+    let start = focus_idx.saturating_sub(half).min(len - max);
+    start..start + max
+}
