{
  // ════════════════════════════════════════════════════════════════
  //  模块定义 · 按功能分组（每组一个胶囊背景，具体见 style.css）
  // ════════════════════════════════════════════════════════════════

  // ── 左侧：工作区 ────────────────────────────────────────────────
  "group/ws": {
    "orientation": "inherit",
    "modules": ["niri/workspaces"],
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "focused": "󰻂",
      "active": "󰄯",
      "urgent": "󰀦",
      "empty": "󰄰",
      "default": "󰄰",
    },
  },

  // ── 左侧：天气 + 日期时间 ───────────────────────────────────────
  "group/weather": {
    "orientation": "inherit",
    "modules": ["custom/weather", "custom/clock"],
  },
  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 600,
    "tooltip": true,
    "on-click": "kitty --class weather -e ~/.config/waybar/scripts/weather.sh --full",
  },
  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "tooltip": true,
    "on-click": "gnome-clocks",
    "on-click-right": "gnome-calendar",
  },

  // ── 左侧：打开的应用 + 托盘（都在 niri-taskbar 插件里） ─────────
  "group/apps": {
    "orientation": "inherit",
    "modules": ["cffi/niri-taskbar"],
  },
  "cffi/niri-taskbar": {
    // 本地编译版：上游 PR #34（支持 niri 26.4 事件流）+ 本地补丁
    //   · 重新编译：~/.config/waybar/scripts/build-niri-taskbar.sh
    //   · 覆盖应用图标：把 <app_id>.png/svg 放进 ~/.config/waybar/icons/
    //   · group_by_app_id：同一应用的多个窗口只显示一个图标（点击在窗口间轮换）
    //   · max_buttons：最多显示几个图标，超出时以聚焦窗口为中心左右切换
    //   · empty_icon：没有任何窗口时显示的占位图标
    //   · right_click_command：右键应用图标时打开的菜单脚本
    //   · tray_icon_size / show_passive_items：插件内置托盘
    "module_path": "/home/lyorn/.local/lib/waybar/libniri_taskbar.so",
    "group_by_app_id": true,
    "max_buttons": 3,
    "empty_icon": "󰀻",
    // "right_click_command": "~/.config/waybar/scripts/taskbar-menu.sh",
    "tray_icon_size": 8,
    "show_passive_items": true,
  },

  // ── 中间：当前聚焦的窗口 ────────────────────────────────────────
  "group/focus": {
    "orientation": "inherit",
    "modules": ["custom/window"],
  },
  "custom/window": {
    "exec": "~/.config/waybar/scripts/window.sh",
    "return-type": "json",
    "tooltip": true,
    "max-length": 100,
  },

  // ── 右侧：网络 + 蓝牙 ───────────────────────────────────────────
  "group/connectivity": {
    "orientation": "inherit",
    "modules": ["network", "bluetooth"],
  },
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": {
      "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "ethernet": "󰈀",
      "disconnected": "󰤮",
    },
    "tooltip-format-wifi": "{essid}\n信号 {signalStrength}% · {ifname}\n{ipaddr}",
    "tooltip-format-ethernet": "有线连接 · {ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "未连接网络",
    "on-click": "~/.config/waybar/scripts/select-network-tui.sh",
    "on-click-right": "nm-connection-editor",
  },
  "bluetooth": {
    "interval": 10,
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format": "蓝牙已开启\n未连接设备",
    "tooltip-format-connected": "{device_alias}\n{device_address}",
    "tooltip-format-disabled": "蓝牙已关闭",
    "on-click": "kitty --class bluetui -e bluetui",
    "on-click-right": "~/.config/waybar/scripts/toggle-bluetooth.sh",
  },

  // ── 右侧：屏幕亮度 + 扬声器/麦克风音量 ──────────────────────────
  "group/media": {
    "orientation": "inherit",
    "modules": ["backlight", "pulseaudio"],
  },
  "backlight": {
    "interval": 5,
    "format": "{icon} {percent}%",
    "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
    "tooltip-format": "屏幕亮度 {percent}%",
    "on-scroll-up": "brightnessctl -q set 5%+",
    "on-scroll-down": "brightnessctl -q set 5%-",
  },
  "pulseaudio": {
    "interval": 5,
    "format": "{icon} {volume}%  {format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭",
    "format-muted": "󰝟  {format_source}",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "bluetooth": "󰥰",
      "speaker": ["󰕿", "󰖀", "󰕾"],
    },
    "tooltip-format": "{desc}\n音量 {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-middle": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
  },

  // ── 右侧：电池 + CPU 频率 + 温度 ────────────────────────────────
  "group/hardware": {
    "orientation": "inherit",
    "modules": ["battery", "custom/cpu", "temperature"],
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 20,
      "critical": 10,
    },
    // 只有真的在充电（status=Charging）才显示带电图标；
    // 插着电源但养护模式/已停充（waybar 状态为 plugged）时用普通电池图标
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{capacity}% · {timeTo}\n{power} W · 健康 {health}%",
    "tooltip-format-charging": "{capacity}% · 充电中\n{timeTo}\n{power} W · 健康 {health}%",
    "tooltip-format-plugged": "{capacity}% · 已插电（未充电）\n{power} W · 健康 {health}%",
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh",
    "return-type": "json",
    "interval": 2,
    "signal": 9,
    "tooltip": true,
    "on-click": "kitty --class btop -e btop",
    "on-click-right": "~/.config/waybar/scripts/cpu.sh --cycle-profile",
  },
  "temperature": {
    "interval": 5,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 80,
    "critical-threshold": 90,
    "format": "󰔄 {temperatureC}°C",
    "tooltip-format": "CPU 封装温度 {temperatureC}°C",
  },

  // ── 右侧：系统更新 ──────────────────────────────────────────────
  "group/updates": {
    "orientation": "inherit",
    "modules": ["custom/updates"],
  },
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 300,
    "signal": 8,
    "tooltip": true,
    "on-click": "kitty --class updates -e ~/.config/waybar/scripts/updates.sh --open",
    "on-click-middle": "kitty --class updates -e ~/.config/waybar/scripts/updates.sh --log",
    "on-click-right": "~/.config/waybar/scripts/updates.sh --force >/dev/null 2>&1",
  },

  // ── 右侧：电源按钮 ──────────────────────────────────────────────
  "group/power": {
    "orientation": "inherit",
    "modules": [
      "custom/lock",
      "custom/suspend",
      "custom/logout",
      "custom/reboot",
      "custom/shutdown",
    ],
  },
  "custom/lock": {
    "format": "󰌾",
    "tooltip-format": "锁定屏幕",
    "on-click": "~/.config/waybar/scripts/powermenu.sh lock",
  },
  "custom/suspend": {
    "format": "󰒲",
    "tooltip-format": "挂起（睡眠）",
    "on-click": "~/.config/waybar/scripts/powermenu.sh suspend",
  },
  "custom/logout": {
    "format": "󰍃",
    "tooltip-format": "注销会话",
    "on-click": "~/.config/waybar/scripts/powermenu.sh logout",
  },
  "custom/reboot": {
    "format": "󰜉",
    "tooltip-format": "重新启动",
    "on-click": "~/.config/waybar/scripts/powermenu.sh reboot",
  },
  "custom/shutdown": {
    "format": "󰐥",
    "tooltip-format": "关机",
    "on-click": "~/.config/waybar/scripts/powermenu.sh shutdown",
  },
}
